---
import Layout from "../layouts/Layout.astro";
import PageShell from "../components/PageShell";
import BathroomsKitchensLondonPage from "../site/pages/BathroomsKitchensLondon";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Bathroom Renovation & Kitchen Installation London",
    provider: {
      "@type": "HomeAndConstructionBusiness",
      name: "Focus Refurbishment Ltd",
      url: "https://focusrefurbishmentltd.com",
      telephone: "02046340020",
    },
    areaServed: ["London", "South East London", "Kent"],
    description:
      "Bathroom renovation and kitchen installation in London. Full design, supply and build for homeowners and landlords. Free home visit.",
    serviceType: "Bathroom and Kitchen Installation",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "How much does it cost to redo a bathroom in London?",
        acceptedAnswer: { "@type": "Answer", text: "A full bathroom refurbishment in London typically costs from around £6,000 to £15,000+ depending on size, spec and how much plumbing needs moving. Luxury shower rooms and larger bathrooms can cost £20,000–£30,000+. We provide a free visit and itemised quote so you know the full cost before work starts." },
      },
      {
        "@type": "Question",
        name: "Is £10,000 enough for a bathroom remodel?",
        acceptedAnswer: { "@type": "Answer", text: "For many standard-sized bathrooms in London, £10,000 is a realistic budget for a mid-range full refurbishment including labour, materials, tiling and sanitaryware — provided the layout stays largely the same. Moving waste pipes, adding a wet room or upgrading everything to premium spec will cost more. We'll advise honestly after the survey." },
      },
      {
        "@type": "Question",
        name: "How much does a new kitchen cost in London?",
        acceptedAnswer: { "@type": "Answer", text: "Kitchen installation costs vary widely with unit quality and whether you're changing the layout. A straightforward replacement kitchen might start from around £8,000–£15,000 fitted. Larger open-plan kitchens with structural changes cost more. We quote supply and installation together with trade pricing on units and worktops." },
      },
      {
        "@type": "Question",
        name: "Do you supply the bathroom suite and kitchen units?",
        acceptedAnswer: { "@type": "Answer", text: "Yes. We design the layout, specify products and supply through trade merchants — so you get professional installation and trade discounts on materials in one package." },
      },
      {
        "@type": "Question",
        name: "How long does a bathroom renovation take?",
        acceptedAnswer: { "@type": "Answer", text: "A standard bathroom refurbishment typically takes 1–2 weeks on site. Larger bathrooms, wet rooms and jobs requiring significant plumbing moves may take 2–3 weeks. We'll confirm a realistic timeline in your quote." },
      },
      {
        "@type": "Question",
        name: "Do you work with residential landlords?",
        acceptedAnswer: { "@type": "Answer", text: "Yes. Bathroom and kitchen refits between tenancies are a regular part of our work. We understand void deadlines and provide clear documentation for agents." },
      },
      {
        "@type": "Question",
        name: "What areas do you cover for bathroom and kitchen installation?",
        acceptedAnswer: { "@type": "Answer", text: "All of Greater London within the M25 and Kent. We're based in Sidcup — well placed for South London and South East London." },
      },
    ],
  },
];
---

<Layout
  title="Bathroom Renovation & Kitchen Installation London | Focus Refurbishment"
  description="Bathroom renovation and kitchen installation in London. Bathroom fitters and kitchen fitters — full design, supply and build. Free home visit. Get a quote today."
  canonicalUrl="https://focusrefurbishmentltd.com/bathrooms-kitchens-london"
  ogTitle="Bathroom Renovation & Kitchen Installation London | Focus Refurbishment"
  ogDescription="Bathroom renovation and kitchen installation in London. Bathroom fitters and kitchen fitters — full design, supply and build. Free home visit."
  ogUrl="https://focusrefurbishmentltd.com/bathrooms-kitchens-london"
  extraJsonLd={jsonLd}
  preconnectOrigins={["https://link.nobleleads.uk"]}
>
  <PageShell client:load>
    <BathroomsKitchensLondonPage client:load />
  </PageShell>
</Layout>
