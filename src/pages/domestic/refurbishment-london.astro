---
import Layout from "../../layouts/Layout.astro";
import PageShell from "../../components/PageShell";
import DomesticRefurbishmentLondonPage from "../../site/pages/DomesticRefurbishmentLondon";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "House Renovation London",
    provider: {
      "@type": "HomeAndConstructionBusiness",
      name: "Focus Refurbishment Ltd",
      url: "https://focusrefurbishmentltd.com",
      telephone: "02046340020",
    },
    areaServed: ["London", "Kent"],
    description:
      "House renovation and full home refurbishment in London and Kent. Victorian, period and modern properties. Design, build and project management under one roof.",
    serviceType: "Home Renovation",
  },
];
---

<Layout
  title="House Renovation London | Full Home Refurbishment | Focus Refurbishment"
  description="House renovation and home refurbishment in London & Kent. Full house and flat renovations, Victorian & period properties. Free survey — get a quote today."
  canonicalUrl="https://focusrefurbishmentltd.com/domestic/refurbishment-london"
  ogTitle="House Renovation London | Full Home Refurbishment | Focus Refurbishment"
  ogDescription="House renovation and home refurbishment in London & Kent. Full house and flat renovations, Victorian & period properties. Free survey — get a quote today."
  ogUrl="https://focusrefurbishmentltd.com/domestic/refurbishment-london"
  extraJsonLd={jsonLd}
  preconnectOrigins={["https://link.nobleleads.uk", "https://player.vimeo.com", "https://i.vimeocdn.com"]}
>
  <PageShell client:load>
    <DomesticRefurbishmentLondonPage />
  </PageShell>
</Layout>
