---
import Layout from "../../layouts/Layout.astro";
import PageShell from "../../components/PageShell";
import FireDoorReplacementFlatsPage, { fireDoorDomesticFaqs } from "../../site/pages/FireDoorReplacementFlats";

const fireDoorFlatsJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Domestic Fire Doors, London",
    provider: {
      "@type": "HomeAndConstructionBusiness",
      name: "Focus Refurbishment Ltd",
      url: "https://focusrefurbishmentltd.com",
      telephone: "07426474899",
      address: {
        "@type": "PostalAddress",
        streetAddress: "144 Hurst Road",
        addressLocality: "Sidcup",
        addressRegion: "Kent",
        postalCode: "DA15 9AF",
        addressCountry: "GB",
      },
    },
    areaServed: ["London", "South East London", "South West London", "Central London", "Kent"],
    description:
      "Fire door replacement and repairs for homes and flats across London and the M25. Fixed price from photos the same day — full FD30 replacement from £1,350 per door, repairs from £350. Covers jobs of up to 3 doors.",
    serviceType: "Fire Door Replacement and Repair",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: fireDoorDomesticFaqs.map((faq) => ({
      "@type": "Question",
      name: faq.q,
      acceptedAnswer: { "@type": "Answer", text: faq.a },
    })),
  },
];
---

<Layout
  title="Domestic Fire Doors London | Fixed Price From Photos, Same Day"
  description="Fire door quotes for flats and homes in London. Full FD30 replacement from £1,350 per door, repairs from £350. Upload photos for a same-day fixed price — no site visit needed."
  canonicalUrl="https://focusrefurbishmentltd.com/domestic/fire-door-replacement-flats-london"
  ogTitle="Domestic Fire Doors London | Fixed Price From Photos, Same Day"
  ogDescription="Fire door quotes for flats and homes in London. Full FD30 replacement from £1,350 per door, repairs from £350. Upload photos for a same-day fixed price — no site visit needed."
  ogUrl="https://focusrefurbishmentltd.com/domestic/fire-door-replacement-flats-london"
  extraJsonLd={fireDoorFlatsJsonLd}
  preconnectOrigins={["https://app.focusrefurbishmentltd.com"]}
>
  <PageShell client:idle>
    <FireDoorReplacementFlatsPage client:idle />
  </PageShell>
</Layout>
