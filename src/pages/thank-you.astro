---
import Layout from "../layouts/Layout.astro";
import PageShell from "../components/PageShell";
import ThankYouPage from "../site/pages/ThankYou";
---

<Layout
  title="Thank You | Focus Refurbishment Ltd"
  description="Thank you for your enquiry. Focus Refurbishment Ltd has received your details and will be in touch shortly."
  canonicalUrl="https://focusrefurbishmentltd.com/thank-you"
  ogTitle="Thank You | Focus Refurbishment Ltd"
  ogDescription="Thank you for your enquiry. Focus Refurbishment Ltd has received your details and will be in touch shortly."
  ogUrl="https://focusrefurbishmentltd.com/thank-you"
  robots="noindex,follow"
>
  <PageShell client:idle>
    <ThankYouPage client:idle />
  </PageShell>

  <script is:inline>
    (function () {
      // Fire immediately — no consent gate on the thank-you page.
      // Consent Mode handles attribution modelling for users who declined;
      // withholding the event entirely means zero data for those leads.
      function fireConversions() {
        if (typeof window.gtag !== "function") return;

        // Matches the GA4 conversion action imported into Google Ads
        window.gtag("event", "form_submission", {
          event_category: "lead",
          event_label: "website_enquiry_form",
        });

        // Keep generate_lead for any GA4 audiences/funnels built on it
        window.gtag("event", "generate_lead", {
          source: "website_enquiry_form",
        });
      }

      // Fire only after gtag.js has fully loaded and configured GA4/Ads.
      // The stub (window.gtag) exists immediately but events sent before
      // gtag("config") runs are not attributed to any property.
      if (window.__gtagLoaded) {
        fireConversions();
      } else {
        window.addEventListener("gtag:loaded", fireConversions, { once: true });
        // Fallback: if the script loaded before this listener registered
        window.addEventListener("load", function () {
          if (window.__gtagLoaded) fireConversions();
        }, { once: true });
      }
    })();
  </script>
</Layout>
