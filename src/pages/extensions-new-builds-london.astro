---
import Layout from "../layouts/Layout.astro";
import PageShell from "../components/PageShell";
import ExtensionsNewBuildsLondonPage from "../site/pages/ExtensionsNewBuildsLondon";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "House Extension London",
    provider: {
      "@type": "HomeAndConstructionBusiness",
      name: "Focus Refurbishment Ltd",
      url: "https://focusrefurbishmentltd.com",
      telephone: "02046340020",
    },
    areaServed: ["London", "South East London", "Kent"],
    description:
      "House extensions in London. Rear, side return and wrap-around extensions. Extension builders — full design and build. Free site survey.",
    serviceType: "House Extension",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "How much does it cost to extend a house in London?",
        acceptedAnswer: { "@type": "Answer", text: "Architect-designed house extensions in London typically cost around £3,000–£5,000 per square metre for a quality build, excluding VAT and professional fees. A single-storey rear extension might total £50,000–£80,000+ depending on size, spec and ground conditions. We provide a free survey and itemised quote for your specific property." },
      },
      {
        "@type": "Question",
        name: "Is £50,000 enough for an extension?",
        acceptedAnswer: { "@type": "Answer", text: "For a modest single-storey rear extension with a standard spec, £50,000 can be a realistic starting budget in London — but ground conditions, glazing, kitchen fit-out and structural complexity all affect the final figure. Two-storey and wrap-around extensions typically cost more. We'll give you an honest assessment after the site visit." },
      },
      {
        "@type": "Question",
        name: "Can I build an extension for £20,000?",
        acceptedAnswer: { "@type": "Answer", text: "A small single-storey extension or garage conversion with a simple spec may come in lower than a full rear extension with bi-folds and a new kitchen. Most full house extensions in London cost significantly more than £20,000. We'll tell you what's achievable on your budget." },
      },
      {
        "@type": "Question",
        name: "What is the 50% rule for house extensions?",
        acceptedAnswer: { "@type": "Answer", text: "Under permitted development, the total area of extensions and other buildings must not cover more than 50% of the total area of land around the original house. There are additional limits on height, depth and proximity to boundaries. We check what applies to your property during the survey." },
      },
      {
        "@type": "Question",
        name: "Do I need planning permission for an extension?",
        acceptedAnswer: { "@type": "Answer", text: "Many single-storey rear extensions fall under permitted development, but restrictions apply — especially in conservation areas, on listed buildings and for flats. Larger extensions and two-storey builds usually need full planning permission. We advise at survey stage." },
      },
      {
        "@type": "Question",
        name: "Do you build garage conversions?",
        acceptedAnswer: { "@type": "Answer", text: "Yes. Converting an existing garage into a habitable room is often more cost-effective than a new extension, subject to building regulations and parking requirements." },
      },
      {
        "@type": "Question",
        name: "What areas do you cover for house extensions?",
        acceptedAnswer: { "@type": "Answer", text: "All of Greater London within the M25 and Kent. We're based in Sidcup — well placed for South London and South East London." },
      },
    ],
  },
];
---

<Layout
  title="House Extension London | Extension Builders | Focus Refurbishment"
  description="House extensions in London. Rear, side return, wrap-around and kitchen extensions. Extension builders — full design and build. Free site survey — get a quote today."
  canonicalUrl="https://focusrefurbishmentltd.com/extensions-new-builds-london"
  ogTitle="House Extension London | Extension Builders | Focus Refurbishment"
  ogDescription="House extensions in London. Rear, side return, wrap-around and kitchen extensions. Extension builders — full design and build."
  ogUrl="https://focusrefurbishmentltd.com/extensions-new-builds-london"
  extraJsonLd={jsonLd}
  preconnectOrigins={["https://link.nobleleads.uk"]}
>
  <PageShell client:load>
    <ExtensionsNewBuildsLondonPage client:load />
  </PageShell>
</Layout>
