---
import Layout from "../layouts/Layout.astro";
import PageShell from "../components/PageShell";
import BrickworkMasonryLondonPage from "../site/pages/BrickworkMasonryLondon";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Brick Repointing London",
    provider: {
      "@type": "HomeAndConstructionBusiness",
      name: "Focus Refurbishment Ltd",
      url: "https://focusrefurbishmentltd.com",
      telephone: "02046340020",
    },
    areaServed: ["London", "South East London", "Kent"],
    description:
      "Brick repointing and brickwork restoration in London. Lime mortar, brick cleaning and facade restoration. Free masonry survey.",
    serviceType: "Brickwork and Masonry",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "How much does brick repointing cost in London?",
        acceptedAnswer: { "@type": "Answer", text: "Repointing costs depend on wall area, access, mortar type and condition of the brick. As a guide, expect from around £80–£120 per square metre for standard repointing, with scaffolding adding to taller elevations. We provide a free assessment and written quote." },
      },
      {
        "@type": "Question",
        name: "Should I use lime mortar or cement for repointing?",
        acceptedAnswer: { "@type": "Answer", text: "Period properties and London stock brick usually need lime-based mortar so the wall can breathe. Modern brickwork may suit cement mortar. Using the wrong type causes cracking and spalled brick faces. We match mortar to the building." },
      },
      {
        "@type": "Question",
        name: "Do you clean painted brick?",
        acceptedAnswer: { "@type": "Answer", text: "Yes. We remove inappropriate paint coatings and clean brickwork using methods appropriate to the brick type — restoring the natural finish without damaging the faces." },
      },
      {
        "@type": "Question",
        name: "How long does repointing last?",
        acceptedAnswer: { "@type": "Answer", text: "Properly executed repointing with the correct mortar typically lasts 50–100 years on period properties. Cheap cement pointing on old brick may fail within years." },
      },
      {
        "@type": "Question",
        name: "What areas do you cover for brickwork and masonry?",
        acceptedAnswer: { "@type": "Answer", text: "All of Greater London within the M25 and Kent. We're based in Sidcup — well placed for South London and South East London." },
      },
    ],
  },
];
---

<Layout
  title="Brick Repointing & Restoration London | Focus Refurbishment"
  description="Brick repointing and brickwork restoration in London. Lime mortar, brick cleaning and period property masonry. Free survey — get a quote today."
  canonicalUrl="https://focusrefurbishmentltd.com/brickwork-masonry-london"
  ogTitle="Brick Repointing & Restoration London | Focus Refurbishment"
  ogDescription="Brick repointing and brickwork restoration in London. Lime mortar, brick cleaning and period property masonry."
  ogUrl="https://focusrefurbishmentltd.com/brickwork-masonry-london"
  extraJsonLd={jsonLd}
  preconnectOrigins={["https://link.nobleleads.uk"]}
>
  <PageShell client:load>
    <BrickworkMasonryLondonPage client:load />
  </PageShell>
</Layout>
