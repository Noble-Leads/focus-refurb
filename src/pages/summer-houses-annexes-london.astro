---
import Layout from "../layouts/Layout.astro";
import PageShell from "../components/PageShell";
import SummerHousesAnnexesLondonPage from "../site/pages/SummerHousesAnnexesLondon";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Garden Room London",
    provider: {
      "@type": "HomeAndConstructionBusiness",
      name: "Focus Refurbishment Ltd",
      url: "https://focusrefurbishmentltd.com",
      telephone: "02046340020",
    },
    areaServed: ["London", "South East London", "Kent"],
    description:
      "Garden rooms, offices and annexes in London. Bespoke design and build. Installations from 3 weeks. Free garden survey.",
    serviceType: "Garden Room Construction",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "How much does a garden room cost in London?",
        acceptedAnswer: { "@type": "Answer", text: "Garden rooms and annexes in London typically cost from around £15,000–£25,000 for a quality insulated build, with larger annexes and buildings with bathrooms costing £25,000–£45,000+. We provide a free survey and itemised quote based on size, spec and foundations required." },
      },
      {
        "@type": "Question",
        name: "Do I need permission to put a garden room in my garden?",
        acceptedAnswer: { "@type": "Answer", text: "Many garden rooms fall under permitted development if they meet size, height and location rules — usually no planning permission needed. Listed buildings, conservation areas and flats have stricter rules. Buildings used as separate self-contained accommodation may need permission. We advise during the survey." },
      },
      {
        "@type": "Question",
        name: "What is the 2.5 metre garden room rule?",
        acceptedAnswer: { "@type": "Answer", text: "Under permitted development, outbuildings within 2 metres of a boundary generally cannot exceed 2.5 metres in eaves height. Further from the boundary, maximum overall height is usually 4 metres for a dual-pitched roof or 3 metres for other roof types. We design within these limits or support a planning application where needed." },
      },
      {
        "@type": "Question",
        name: "Is a garden room cheaper than a conservatory?",
        acceptedAnswer: { "@type": "Answer", text: "A properly insulated garden room is often better value long-term than a conservatory — usable year-round, better insulation, and usually cheaper per square metre than a full house extension. Conservatories can overheat in summer and lose heat in winter." },
      },
      {
        "@type": "Question",
        name: "How long does a garden room take to build?",
        acceptedAnswer: { "@type": "Answer", text: "Once design and materials are agreed, many of our garden room installations complete on site from around 3 weeks — depending on size, foundations and whether plumbing is included." },
      },
      {
        "@type": "Question",
        name: "Can you build a garden annexe with a bathroom?",
        acceptedAnswer: { "@type": "Answer", text: "Yes. We design and build annexes with kitchenettes and bathrooms where the plot, services and planning rules allow." },
      },
      {
        "@type": "Question",
        name: "What areas do you cover for garden rooms and annexes?",
        acceptedAnswer: { "@type": "Answer", text: "All of Greater London within the M25 and Kent. We're based in Sidcup — well placed for South London and South East London." },
      },
    ],
  },
];
---

<Layout
  title="Garden Room London | Garden Offices & Annexes | Focus Refurbishment"
  description="Garden rooms in London. Bespoke garden offices, annexes and summer houses. Design and build — installations from 3 weeks. Free garden survey."
  canonicalUrl="https://focusrefurbishmentltd.com/summer-houses-annexes-london"
  ogTitle="Garden Room London | Garden Offices & Annexes | Focus Refurbishment"
  ogDescription="Garden rooms in London. Bespoke garden offices, annexes and summer houses. Design and build — installations from 3 weeks."
  ogUrl="https://focusrefurbishmentltd.com/summer-houses-annexes-london"
  extraJsonLd={jsonLd}
  preconnectOrigins={["https://link.nobleleads.uk"]}
>
  <PageShell client:load>
    <SummerHousesAnnexesLondonPage client:load />
  </PageShell>
</Layout>
