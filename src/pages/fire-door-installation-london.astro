---
import Layout from "../layouts/Layout.astro";
import PageShell from "../components/PageShell";
import FireDoorInstallationPage from "../site/pages/FireDoorInstallation";

const fireDoorJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Fire Door Installation & Surveys London",
    provider: {
      "@type": "HomeAndConstructionBusiness",
      name: "Focus Refurbishment Ltd",
      url: "https://focusrefurbishmentltd.com",
      telephone: "02046340020",
      address: {
        "@type": "PostalAddress",
        streetAddress: "144 Hurst Road",
        addressLocality: "Sidcup",
        addressRegion: "Kent",
        postalCode: "DA15 9AF",
        addressCountry: "GB",
      },
    },
    areaServed: ["London", "South East London", "South West London", "Central London", "Kent"],
    description:
      "Experienced fire door installers across London and the M25. FD30 and FD60 supply, installation, surveys, maintenance and replacement with compliance documentation on completion.",
    serviceType: "Fire Door Installation",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "Do you offer fire door inspection in London?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Yes. Focus Refurbishment carries out fire door surveys for landlords and agents, checking gaps, hinges, closers, seals and signage. Remedial works and replacements are carried out where needed.",
        },
      },
      {
        "@type": "Question",
        name: "Do you provide compartmentation fire stopping?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Focus Refurbishment focuses on fire door supply, installation and door-set sealing. Specialist passive fire stopping around service penetrations is a separate discipline — enquire to discuss scope or coordination.",
        },
      },
      {
        "@type": "Question",
        name: "How quickly can you carry out a survey?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "We aim to carry out surveys within the week of your enquiry.",
        },
      },
      {
        "@type": "Question",
        name: "What documentation do I receive after installation?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "You receive compliance documentation including installer certificates and product data sheets.",
        },
      },
    ],
  },
];
---

<Layout
  title="Fire Door Installers London | FD30 & FD60 Installation & Surveys"
  description="Fire door installers in London. FD30 & FD60 supply, installation, surveys, maintenance and replacement. Experienced team — compliance documentation on completion."
  canonicalUrl="https://focusrefurbishmentltd.com/fire-door-installation-london"
  ogTitle="Fire Door Installers London | FD30 & FD60 Installation & Surveys"
  ogDescription="Fire door installers in London. FD30 & FD60 supply, installation, surveys, maintenance and replacement. Experienced team — compliance documentation on completion."
  ogUrl="https://focusrefurbishmentltd.com/fire-door-installation-london"
  extraJsonLd={fireDoorJsonLd}
  preconnectOrigins={["https://link.nobleleads.uk"]}
>
  <PageShell client:load>
    <FireDoorInstallationPage />
  </PageShell>
</Layout>
