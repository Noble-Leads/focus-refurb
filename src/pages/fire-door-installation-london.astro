---
import Layout from "../layouts/Layout.astro";
import PageShell from "../components/PageShell";
import FireDoorInstallationPage, { fireDoorFaqs } from "../site/pages/FireDoorInstallation";

const fireDoorJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Fire Door Installation & Surveys London",
    provider: {
      "@type": "HomeAndConstructionBusiness",
      name: "Focus Refurbishment Ltd",
      url: "https://focusrefurbishmentltd.com",
      telephone: "07426474899",
      address: {
        "@type": "PostalAddress",
        streetAddress: "144 Hurst Road",
        addressLocality: "Sidcup",
        addressRegion: "Kent",
        postalCode: "DA15 9AF",
        addressCountry: "GB",
      },
    },
    areaServed: ["London", "South East London", "South West London", "Central London", "Kent"],
    description:
      "Commercial fire door surveys, installation and remedial works across London and the M25. FD30 and FD60 doorsets supplied and fitted from £1,750, free door-by-door surveys and compliance documentation on completion.",
    serviceType: "Fire Door Installation",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: fireDoorFaqs.map((faq) => ({
      "@type": "Question",
      name: faq.q,
      acceptedAnswer: { "@type": "Answer", text: faq.a },
    })),
  },
];
---

<Layout
  title="Fire Door Installation London | Internal & External FD30 & FD60"
  description="Fire door installation in London for managing agents, facilities managers and landlords. FD30 & FD60 doorsets fitted from £1,750, free door-by-door survey, fixed quote and compliance documentation."
  canonicalUrl="https://focusrefurbishmentltd.com/fire-door-installation-london"
  ogTitle="Fire Door Installation London | Internal & External FD30 & FD60"
  ogDescription="Fire door installation in London for managing agents, facilities managers and landlords. FD30 & FD60 doorsets fitted from £1,750, free door-by-door survey, fixed quote and compliance documentation."
  ogUrl="https://focusrefurbishmentltd.com/fire-door-installation-london"
  extraJsonLd={fireDoorJsonLd}
  preconnectOrigins={["https://link.nobleleads.uk"]}
>
  <PageShell client:idle>
    <FireDoorInstallationPage client:idle />
  </PageShell>
</Layout>
