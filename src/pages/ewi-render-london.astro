---
import Layout from "../layouts/Layout.astro";
import PageShell from "../components/PageShell";
import EwiRenderLondonPage from "../site/pages/EwiRenderLondon";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "External Wall Insulation London",
    provider: {
      "@type": "HomeAndConstructionBusiness",
      name: "Focus Refurbishment Ltd",
      url: "https://focusrefurbishmentltd.com",
      telephone: "02046340020",
    },
    areaServed: ["London", "South East London", "Kent"],
    description:
      "External wall insulation and silicone render in London. EWI systems, pebble-dash removal and house rendering. Free exterior survey.",
    serviceType: "External Wall Insulation",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "How much does external wall insulation cost in the UK?",
        acceptedAnswer: { "@type": "Answer", text: "EWI costs depend on wall area, system specification, scaffolding and render finish. As a broad guide, external wall insulation typically costs from around £100–£150 per square metre installed. We provide a free survey and itemised quote for your property." },
      },
      {
        "@type": "Question",
        name: "What is external wall insulation?",
        acceptedAnswer: { "@type": "Answer", text: "Insulation boards are fixed to the outside of your walls, covered with mesh and render. It reduces heat loss through solid walls and gives a fresh exterior finish — particularly effective on properties without cavity walls." },
      },
      {
        "@type": "Question",
        name: "Can you remove pebble-dash and render the house?",
        acceptedAnswer: { "@type": "Answer", text: "Yes. We strip failing pebble-dash or old render, prepare the substrate and apply a new insulated render system or re-render depending on what's appropriate for the property." },
      },
      {
        "@type": "Question",
        name: "Do I need planning permission for external wall insulation?",
        acceptedAnswer: { "@type": "Answer", text: "In many cases EWI is permitted development, but there are restrictions on thickness, appearance and location — especially in conservation areas and on listed buildings. We advise during the survey." },
      },
      {
        "@type": "Question",
        name: "What areas do you cover for external wall insulation?",
        acceptedAnswer: { "@type": "Answer", text: "All of Greater London within the M25 and Kent. We're based in Sidcup — well placed for South London and South East London." },
      },
    ],
  },
];
---

<Layout
  title="External Wall Insulation & Render London | Focus Refurbishment"
  description="External wall insulation and silicone render in London. EWI systems, pebble-dash removal and house rendering. Free survey — get a quote today."
  canonicalUrl="https://focusrefurbishmentltd.com/ewi-render-london"
  ogTitle="External Wall Insulation & Render London | Focus Refurbishment"
  ogDescription="External wall insulation and silicone render in London. EWI systems, pebble-dash removal and house rendering."
  ogUrl="https://focusrefurbishmentltd.com/ewi-render-london"
  extraJsonLd={jsonLd}
  preconnectOrigins={["https://link.nobleleads.uk"]}
>
  <PageShell client:load>
    <EwiRenderLondonPage client:load />
  </PageShell>
</Layout>
